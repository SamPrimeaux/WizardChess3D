{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inneranimalmedia.com/schemas/wizard-chess-3d/settings.schema.json",
  "title": "Wizard Chess 3D Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "playMode",
    "playerColor",
    "difficulty",
    "clockPreset",
    "clockDirection",
    "soundMuted",
    "graphicsQuality",
    "reducedMotion",
    "rendererPreference"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "arenaId": { "type": "string", "enum": ["cathedral", "robotics"] },
    "playMode": { "type": "string", "enum": ["ai", "local"] },
    "playerColor": { "type": "string", "enum": ["w", "b"] },
    "difficulty": { "type": "string", "enum": ["novice", "club", "master"] },
    "clockPreset": { "type": "string", "enum": ["bullet", "blitz", "rapid", "unlimited"] },
    "clockDirection": { "type": "string", "enum": ["down", "up"] },
    "soundMuted": { "type": "boolean" },
    "graphicsQuality": { "type": "string", "enum": ["low", "medium", "high"] },
    "reducedMotion": { "type": "string", "enum": ["system", "on", "off"] },
    "rendererPreference": { "type": "string", "enum": ["auto", "2d"] }
  }
}
